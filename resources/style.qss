/* Neutral surfaces and one primary accent keep the interface readable while
   type-specific visitors provide the semantic colours. */

QMainWindow,
QWidget {
    background-color: #F4F6FA;
    color: #1F2937;
    font-size: 14px;
}

QMenuBar {
    background-color: #FFFFFF;
    color: #1F2937;
    border-bottom: 1px solid #DDE3EC;
    spacing: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 9px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #EEF2FF;
}

QMenu {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #D7DDE8;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 8px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #EEF2FF;
    color: #312E81;
}

QMenu::separator {
    height: 1px;
    background-color: #E5E9F0;
    margin: 5px 7px;
}

QStatusBar {
    background-color: #FFFFFF;
    color: #64748B;
    border-top: 1px solid #DDE3EC;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #B9C2D0;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QSplitter#mainWorkspaceSplitter::handle:horizontal {
    background-color: #CBD3E1;
    width: 9px;
    margin: 0 3px;
    border-radius: 1px;
}

QSplitter#mainWorkspaceSplitter::handle:horizontal:hover,
QSplitter#mainWorkspaceSplitter::handle:horizontal:pressed {
    background-color: #818CF8;
}

QSplitter#detailOverviewSplitter::handle:vertical {
    background-color: #DDE3EC;
    height: 8px;
    margin: 3px 0;
    border-radius: 1px;
}

QSplitter#detailOverviewSplitter::handle:vertical:hover,
QSplitter#detailOverviewSplitter::handle:vertical:pressed {
    background-color: #A5B4FC;
}

QStackedWidget#workspaceStack {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EC;
    border-radius: 10px;
}

QLabel {
    color: #1F2937;
    font-size: 14px;
}

QLabel#resultCountLabel {
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    margin-top: 4px;
    margin-bottom: 2px;
}

QLabel#sectionLabel,
QLabel#filterFieldLabel {
    color: #334155;
    font-weight: 600;
}

QLabel#sectionLabel {
    font-size: 15px;
    margin-top: 5px;
}

QGroupBox {
    background-color: #F8FAFD;
    color: #1F2937;
    font-weight: 600;
    border: 1px solid #D9E0EA;
    border-radius: 8px;
    margin-top: 7px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #334155;
    background-color: #F4F6FA;
}

QGroupBox#filterPanel {
    background-color: #F8FAFD;
}

QLineEdit,
QTextEdit,
QComboBox,
QDateTimeEdit,
QSpinBox,
QAbstractSpinBox {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #C8D0DC;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QLineEdit#activitySearchField {
    padding-top: 5px;
    padding-bottom: 5px;
    border-color: #B8C2D1;
}

QLineEdit:hover,
QTextEdit:hover,
QComboBox:hover,
QDateTimeEdit:hover,
QSpinBox:hover,
QAbstractSpinBox:hover {
    border-color: #9BA8BB;
}

QTextEdit {
    padding: 7px;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QDateTimeEdit:focus,
QSpinBox:focus,
QAbstractSpinBox:focus {
    border: 1px solid #4F46E5;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #D7DDE8;
    background-color: #F8FAFD;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/icons/dropdown_arrow.svg);
    width: 12px;
    height: 8px;
}

QComboBox::drop-down:hover,
QDateTimeEdit::drop-down:hover {
    background-color: #EEF2F7;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #C8D0DC;
    outline: 0;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    background-color: #FFFFFF;
    color: #1F2937;
    min-height: 24px;
    padding: 5px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #EEF2FF;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #4F46E5;
    color: #FFFFFF;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background-color: #F8FAFD;
    width: 16px;
    border-left: 1px solid #D7DDE8;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: #EEF2F7;
}

QListWidget {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #D7DDE8;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
}

QListWidget::item {
    padding: 7px 8px;
    border-bottom: 1px solid #EDF0F4;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #F1F4FF;
    color: #1F2937;
}

QListWidget::item:selected {
    background-color: #4F46E5;
    color: #FFFFFF;
}

QTextEdit {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #D7DDE8;
    border-radius: 8px;
}

QPushButton {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #C8D0DC;
    border-radius: 6px;
    padding: 5px 9px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #F1F4F8;
    border-color: #AEB8C7;
}

QPushButton:pressed {
    background-color: #E5EAF1;
}

QPushButton:focus {
    border: 1px solid #4F46E5;
}

QPushButton:disabled {
    background-color: #E9EDF2;
    color: #8A96A8;
    border: 1px solid #D5DBE4;
}

QPushButton[compactAction="true"] {
    padding: 4px 8px;
    min-height: 22px;
    max-height: 30px;
    text-align: center;
}

QPushButton#accentButton[compactAction="true"] {
    min-height: 26px;
    max-height: 32px;
}

QPushButton#filterToggleButton {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #D0D7E2;
    text-align: left;
}

QPushButton#filterToggleButton:checked {
    background-color: #EEF2FF;
    color: #3730A3;
    border: 1px solid #818CF8;
}

QPushButton#accentButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: 1px solid #4338CA;
    font-weight: 650;
    min-height: 30px;
}

QPushButton#accentButton:hover {
    background-color: #4338CA;
    border-color: #3730A3;
}

QPushButton#primaryButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: 1px solid #4338CA;
}

QPushButton#primaryButton:hover {
    background-color: #4338CA;
}

QPushButton#primaryButton:pressed {
    background-color: #3730A3;
}

QPushButton#dangerButton {
    background-color: #FFFFFF;
    color: #B42318;
    border: 1px solid #D92D20;
}

QPushButton#dangerButton:hover {
    background-color: #FFF1F0;
}

QPushButton#dangerButton:pressed {
    background-color: #FFE4E1;
}

QPushButton#primaryButton:disabled,
QPushButton#dangerButton:disabled {
    background-color: #E9EDF2;
    color: #8A96A8;
    border: 1px solid #D5DBE4;
}

QPushButton#monthNavigationButton,
QPushButton#monthTodayButton {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #C8D0DC;
    padding: 0;
    min-height: 30px;
    max-height: 32px;
}

QPushButton#monthTodayButton {
    padding: 0 8px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#monthNavigationButton:hover,
QPushButton#monthTodayButton:hover {
    background-color: #EEF2FF;
    border-color: #818CF8;
}

QProgressBar {
    background-color: #E7ECF2;
    color: #334155;
    border: none;
    border-radius: 5px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4F46E5;
    border-radius: 5px;
}

QListWidget::indicator,
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #64748B;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QListWidget::indicator:hover,
QCheckBox::indicator:hover {
    border: 1px solid #4F46E5;
    background-color: #EEF2FF;
}

QListWidget::indicator:checked,
QCheckBox::indicator:checked {
    border: 1px solid #4338CA;
    background-color: #4F46E5;
}

QListWidget::indicator:disabled,
QCheckBox::indicator:disabled {
    border: 1px solid #AAB4C2;
    background-color: #DDE3EA;
}

QToolTip {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 1px solid #334155;
    padding: 5px 7px;
}
